[Unit]
Description=Dochazka Kerberos enrollment gateway
After=network-online.target samba-ad-dc.service
Wants=network-online.target

[Service]
User=dochazka-gateway
Group=dochazka-gateway
Environment=KRB5_CONFIG=/etc/dochazka-gateway/krb5.conf
RuntimeDirectory=dochazka-gateway
RuntimeDirectoryMode=0750
LogsDirectory=dochazka-gateway
LogsDirectoryMode=0750
UMask=0027
ExecStart=/usr/sbin/apache2 -f /etc/dochazka-gateway/httpd.conf -DFOREGROUND
ExecReload=/usr/sbin/apache2 -f /etc/dochazka-gateway/httpd.conf -k graceful
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
