{
  "openapi": "3.1.0",
  "info": {
    "title": "Docházka API",
    "version": "1.0.0",
    "description": "Evidence pracovní doby, žádosti, zařízení a uzávěrky. Webové požadavky používají JSON a hlavičku X-Dochazka."
  },
  "components": {
    "schemas": {
      "EmployeeRoles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": ["employee", "manager", "payroll", "admin"]
        }
      },
      "Person": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "number": {
            "type": ["string", "null"]
          },
          "login": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "$ref": "#/components/schemas/EmployeeRoles"
          },
          "attendance_enabled": {
            "type": "boolean"
          },
          "archived_on": {
            "type": ["string", "null"],
            "format": "date"
          },
          "team": {
            "type": "string"
          },
          "sid": {
            "type": [
              "string",
              "null"
            ]
          },
          "starts": {
            "type": "string",
            "format": "date"
          },
          "ends": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      },
      "Signal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "login",
              "logout",
              "sleep",
              "resume",
              "gap"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "sid": {
            "type": "string"
          },
          "session": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "at",
          "sid",
          "session"
        ]
      },
      "Row": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PRACE",
              "LEKAR",
              "DOVOLENA",
              "PRESTAVKA"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "Request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PRACE",
              "LEKAR",
              "DOVOLENA",
              "PRESTAVKA"
            ]
          },
          "begins": {
            "type": "string",
            "format": "date-time"
          },
          "ends": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_proof": {
            "type": "boolean"
          }
        }
      },
      "Sheet": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Row"
            }
          },
          "seconds": {
            "type": "integer"
          },
          "pending": {
            "type": "integer"
          },
          "missing_proofs": {
            "type": "integer",
            "description": "Počet schválených návštěv lékaře, ke kterým ještě chybí propustka."
          },
          "vacation_conflict": {
            "type": "boolean",
            "description": "Dovolená se překrývá s prací nebo lékařem a výkaz nelze schválit."
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Request"
            }
          },
          "fingerprint": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "approval": {
            "oneOf": [
              {
                "type": "boolean",
                "const": false
              },
              {
                "type": "object"
              }
            ]
          }
        }
      },
      "Payroll": {
        "type": "object",
        "properties": {
          "changed": {
            "type": "boolean"
          },
          "people": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "approved": {
                  "type": "boolean"
                }
              }
            }
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "integer"
                },
                "created": {
                  "type": "string",
                  "format": "date-time"
                },
                "fingerprint": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "seen": {
            "type": [
              "string",
              "null"
            ]
          },
          "revoked": {
            "type": "boolean"
          },
          "registered": {
            "type": "boolean"
          },
          "warnings": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "gateway": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Dochazka-Gateway PRINCIPAL:TIMESTAMP:NONCE:SIGNATURE. Podpis HMAC-SHA256 vytváří interní registrační brána."
      },
      "kerberos": {
        "type": "http",
        "scheme": "negotiate",
        "description": "Kerberos účtu počítače na doménové registrační bráně."
      },
      "device": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "PHPSESSID"
      }
    },
    "parameters": {
      "WebHeader": {
        "name": "X-Dochazka",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "web"
          ]
        }
      }
    },
    "responses": {
      "Activate": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Error401": {
        "description": "Je potřeba ověření.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error403": {
        "description": "Chybí oprávnění.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error409": {
        "description": "Konflikt se stavem evidence.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error422": {
        "description": "Neplatné údaje.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Close": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Payroll"
            }
          }
        }
      },
      "Devices": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Device"
              }
            }
          }
        }
      },
      "Download": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "csv": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Employee": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Enroll": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Events": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "accepted",
                          "duplicate",
                          "unmapped",
                          "ignored",
                          "invalid",
                          "conflict"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "example": {
              "results": [
                {
                  "id": "pc1.103",
                  "status": "accepted"
                }
              ]
            }
          }
        }
      },
      "Invite": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Login": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Person"
            }
          }
        }
      },
      "People": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Person"
              }
            }
          }
        }
      },
      "Sheet": {
        "description": "Úspěch",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Sheet"
            }
          }
        }
      },
      "MedicalProof": {
        "description": "Fotografie propustky",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "jpeg": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "contentMediaType": "image/jpeg"
                }
              }
            }
          }
        }
      }
    },
    "requestBodies": {
      "Activate": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "password": {
                  "type": "string",
                  "minLength": 12
                }
              },
              "required": [
                "code",
                "password"
              ]
            }
          }
        }
      },
      "Approve": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "employee": {
                  "type": "integer"
                },
                "month": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                  "example": "2026-11"
                },
                "fingerprint": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "employee",
                "month",
                "fingerprint"
              ]
            }
          }
        }
      },
      "Close": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "month": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                  "example": "2026-11"
                }
              }
            }
          }
        }
      },
      "Decide": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "approved",
                    "rejected"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "status"
              ]
            }
          }
        }
      },
      "Devices": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
          }
        }
      },
      "Download": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "month": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                  "example": "2026-11"
                },
                "version": {
                  "type": "integer"
                }
              },
              "required": [
                "month",
                "version"
              ]
            }
          }
        }
      },
      "Employee": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "number": {
                  "type": ["string", "null"],
                  "description": "Osobní číslo je povinné při zpracování docházky. Pro ostatní účty lze pole vynechat nebo použít null."
                },
                "login": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "roles": {
                  "$ref": "#/components/schemas/EmployeeRoles"
                },
                "attendance_enabled": {
                  "type": "boolean"
                },
                "team": {
                  "type": "string"
                },
                "sid": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "starts": {
                  "type": "string",
                  "format": "date"
                },
                "ends": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                }
              },
              "required": [
                "name",
                "team",
                "login",
                "roles",
                "attendance_enabled",
                "starts"
              ],
              "if": {
                "required": ["attendance_enabled"],
                "properties": { "attendance_enabled": { "const": true } }
              },
              "then": {
                "required": ["number"],
                "properties": { "number": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      },
      "Enroll": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        }
      },
      "Events": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "events": {
                  "maxItems": 250,
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Signal"
                  }
                },
                "resolved_warning": {
                  "type": ["string", "null"],
                  "description": "Označí dřívější hlášení této stanice za vyřešené."
                },
                "warning": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "events"
              ]
            },
            "example": {
              "events": [
                {
                  "id": "pc1.103",
                  "kind": "login",
                  "at": "2026-11-02T08:00:00+01:00",
                  "sid": "S-1-5-21-1-2-3-1001",
                  "session": "boot3.41"
                }
              ]
            }
          }
        }
      },
      "Invite": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        }
      },
      "Login": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "login": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "login",
                "password"
              ]
            }
          }
        }
      },
      "Register": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        }
      },
      "Request": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "PRACE",
                    "LEKAR",
                    "DOVOLENA",
                    "PRESTAVKA"
                  ]
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "employee": {
                  "type": "integer"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "from",
                "to"
              ]
            },
            "example": {
              "kind": "LEKAR",
              "from": "2026-11-02T10:00",
              "to": "2026-11-02T11:00"
            }
          }
        }
      },
      "MedicalProofUpload": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["id", "photo"],
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "ID vlastní schválené žádosti o návštěvu lékaře."
                },
                "photo": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "description": "Fotografie JPEG nebo PNG do 5 MiB a 16 megapixelů."
                }
              }
            }
          }
        }
      },
      "Sheet": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "employee": {
                  "type": "integer"
                },
                "month": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                  "example": "2026-11"
                }
              }
            }
          }
        }
      }
    }
  }
}
